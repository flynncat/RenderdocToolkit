# =============================================================================
# RenderDoc 工具集 — .gitignore
#
# 原则：
# - 本地运行产物、抓帧、会话、调试 scratch → 忽略
# - PyInstaller 绿色包依赖的 bundled runtime（external_tools、docs/images、
#   .cursor/skills）→ 必须提交为普通 git blob，不能忽略，也不能走 LFS 指针
# - 克隆后运行 `python scripts/verify_bundled_assets.py` 可检查关键资源是否齐全
# =============================================================================

# --- Python / 打包输出 ---
__pycache__/
*.py[cod]
**/__pycache__/
build/
dist/

# --- 本地运行数据（每台机器各自生成）---
logs/
user_data/
sessions/
cmp_sessions/
perf_sessions/
export_jobs/
output/

# --- 本地配置（含密钥/路径；打包脚本会生成 user_data/config/settings.json）---
config/settings.json
docs/demo_home/

# --- 临时测试目录 ---
.tmp-asset-test/
_smoke_wf/
test_reports/
verify_sessions/
build_portable.log

# --- 本地抓帧与导出 scratch ---
*.rdc
*_RenderdocDiffExport/

# --- 调试/临时 CSV、模型、JSON（仅限本地 scratch，勿放到 bundled 目录下）---
.tmp_vsin_*.csv
.tmp_vsin_*.fbx
third_round_*.json
out_*/
second_round_out/

# --- 任务目录内生成的缩略图 / draw 列表（勿用全局 *_thumb.png，以免误伤）---
sessions/**/*_thumb.png
cmp_sessions/**/*_thumb.png
perf_sessions/**/*_thumb.png
export_jobs/**/*_thumb.png
sessions/**/*_draws.json
cmp_sessions/**/*_draws.json
perf_sessions/**/*_draws.json

# --- IDE ---
.vscode/

# --- renderdoccmp 运行时工作区（非 bundled 工具本身）---
external_tools/renderdoccmp/output/
external_tools/renderdoccmp/sample/
external_tools/renderdoccmp/**/*.zip
external_tools/renderdoccmp/**/*.zip.xml
external_tools/renderdoccmp/**/*_extracted/
external_tools/renderdoccmp/**/__pycache__/
external_tools/renderdoccmp/test_*.html
external_tools/renderdoccmp/test_*.png
external_tools/renderdoccmp/thumb_*.png

# --- 勿提交 UGit 自动生成的 bulk LFS .gitattributes 备份 ---
.gitattributes.ugit
.gitattributes.bak

# =============================================================================
# Bundled runtime 保护（PyInstaller datas 依赖 — 禁止忽略）
# 若新增 ignore 规则，请确认不会匹配以下路径：
#   external_tools/renderdoccmp/tools/**  (*.exe / *.dll)
#   external_tools/renderdoccmp/{*.py,*.md,*.js}
#   external_tools/renderdoccmp/qr_replay_worker.py
#   docs/images/**
#   .cursor/skills/**
# =============================================================================
!external_tools/renderdoccmp/
!external_tools/renderdoccmp/**
!docs/images/
!docs/images/**
!.cursor/skills/
!.cursor/skills/**
